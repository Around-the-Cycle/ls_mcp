# Lightspeed Retail (R-Series) OAuth2 credentials.
#
# Either spelling works — the LIGHTSPEED_* names are what the atc-qbp Rails
# app uses, so credentials copied from there can be pasted in as-is:
#   LS_CLIENT_ID     / LIGHTSPEED_USERNAME
#   LS_CLIENT_SECRET / LIGHTSPEED_PASS
#   LS_REFRESH_TOKEN / LIGHTSPEED_OAUTH_REFRESH_TOKEN
#   LS_ACCOUNT_ID    / LIGHTSPEED_ACCOUNT_ID
#
# This file is gitignored. Never commit real credentials.
LS_CLIENT_ID=
LS_CLIENT_SECRET=
LS_REFRESH_TOKEN=
LS_ACCOUNT_ID=
